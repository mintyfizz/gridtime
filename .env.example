# --- Storage (MinIO, local S3) ---
MINIO_ROOT_USER=gridtime
MINIO_ROOT_PASSWORD=change-me-please
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lakehouse

# --- Iceberg catalog (SQLite file for now; Nessie in milestone 6) ---
CATALOG_URI=sqlite:///catalog/catalog.db

# --- Elia Open Data ---
ELIA_BASE_URL=https://opendata.elia.be/api/explore/v2.1
# Comma-separated dataset IDs to poll.
# ods175 = balancing energy price components per minute (near real-time, non-validated)
# ods165 = same measure, historical (refreshed daily)
ELIA_DATASETS=ods175,ods165
ELIA_PAGE_SIZE=100
ELIA_LOOKBACK_MINUTES=120
# Per-dataset lookback overrides (minutes). ods165 is refreshed daily and ends at
# yesterday, so it needs ~2 days to always cover the latest validated values.
ELIA_LOOKBACK_OVERRIDES=ods165=2880
POLL_INTERVAL_SECONDS=60

# --- Streaming (Redpanda, Kafka API) ---
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC_PREFIX=elia
KAFKA_CONSUMER_GROUP=bronze-sink
KAFKA_RETENTION_DAYS=7
